DEPLOYMENT_ENV=production
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
USE_X_FORWARDED_PROTO=True
DB_NAME=taxi_backend
DB_USER=taxi
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
PRESENCE_REDIS_URL=redis://redis:6379/0
OTP_DELIVERY_BACKEND=REPLACE_WITH_SMS_PROVIDER
MAPS_ROUTING_BASE_URL=https://ROUTING_PROVIDER_URL
NOTIFICATION_BACKEND=notifications.backends.fcm.FCMBackend
FCM_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
MAPS_ROUTING_REQUIRED=False
# بلاطات الخريطة للتطبيقين (مفتاح عميل مقيَّد بمعرّف التطبيق عند المزوّد)
MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=REPLACE_WITH_TILES_KEY
MAP_TILES_DARK_URL=
MAP_TILES_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# مفتاح FCM بديلًا عن الملف: محتوى JSON أو Base64 (للسحابة)
# FCM_SERVICE_ACCOUNT_JSON=
