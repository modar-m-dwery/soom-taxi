# ---------------------------------------------------------------
# بيئة التطوير المحلّية (بلا دوكر للتطبيق) — سووم تكسي
#
#   انسخ هذا الملفّ إلى .env  ثمّ عدّل ما يلزم. لا ترفع .env إلى المستودع.
#   postgres وredis يأتيان من:  docker compose up -d   (compose.yaml)
#   فالمنفذ 5433 هو منفذ postgres المنشور على جهازك.
# ---------------------------------------------------------------

DEPLOYMENT_ENV=development
DEBUG=True
# أيّ نصّ طويل للتطوير؛ الإنتاج يرفض المفتاح القصير أو django-insecure-
SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
# * للتطوير فقط: محاكي أندرويد يطلب 10.0.2.2 والهاتف الحقيقيّ عنوان الشبكة
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

DB_NAME=taxi_backend
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_HOST=127.0.0.1
DB_PORT=5433

REDIS_URL=redis://127.0.0.1:6379/0

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# الهاتف: 3 طلبات خلال 10 دقائق.
OTP_RATE_PHONE_LIMIT=3
OTP_RATE_PHONE_WINDOW=600
# الجهاز: 5 طلبات خلال 10 دقائق.
OTP_RATE_DEVICE_LIMIT=5
OTP_RATE_DEVICE_WINDOW=600
# IP: 10 طلبات خلال 10 دقائق.
OTP_RATE_IP_LIMIT=10
OTP_RATE_IP_WINDOW=600


# الرموز والإشعارات تُطبع في السجلّ بدل أن تُرسل — التطوير لا يرسل رسائل حقيقيّة
OTP_DELIVERY_BACKEND=console
NOTIFICATION_BACKEND=notifications.backends.console.ConsoleBackend

# التوجيه: OSRM العامّ للتجربة فقط، والسعر يُحسب تقديريًّا إن تعذّر
MAPS_ROUTING_ENABLED=True
MAPS_ROUTING_REQUIRED=False

# ويندوز فقط: مسار مكتبات GeoDjango من OSGeo4W إن لم تُكتشف وحدها
# GDAL_LIBRARY_PATH=C:/OSGeo4W/bin/gdalXXX.dll
# GEOS_LIBRARY_PATH=C:/OSGeo4W/bin/geos_c.dll
