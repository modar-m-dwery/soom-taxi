# ---------------------------------------------------------------
# بيئة التطوير داخل دوكر — سووم تكسي
#
#   cp .env.docker.example .env.docker   ثمّ:
#   docker compose -f compose.dev.yaml up -d --build
#
# الفرق عن .env المحلي:
#   • DB_HOST/REDIS_URL يشيران إلى أسماء خدمات الشبكة لا 127.0.0.1
#   • DB_PORT هو 5432 (المنفذ داخل الشبكة) لا 5433 (المنفذ المنشور للمضيف)
#   • لا مسارات ويندوز لـGDAL/GEOS — لينكس يجدها وحده
#   • الإشعارات والـOTP على الطابعة، فلا تُرسل رسائل حقيقية من التطوير
# ---------------------------------------------------------------

DEPLOYMENT_ENV=development
DEBUG=True
# أيّ نصّ طويل للتطوير؛ الإنتاج يرفض القصير أو django-insecure-
SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
# ALLOWED_HOSTS=127.0.0.1,localhost,testserver,web,0.0.0.0
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# لا نُجبر HTTPS في التطوير، وإلا صار كل طلب HTTP تحويلًا 301
SECURE_SSL_REDIRECT=False

# قاعدة البيانات — الاسم "postgres" هو اسم الخدمة في compose
DB_NAME=taxi_backend
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_HOST=postgres
DB_PORT=5432

# ريديس — الاسم "redis" هو اسم الخدمة في compose
REDIS_URL=redis://redis:6379/0
PRESENCE_REDIS_URL=redis://redis:6379/1

# --------------------------- OTP ---------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# الهاتف: 3 طلبات خلال 10 دقائق
OTP_RATE_PHONE_LIMIT=3
OTP_RATE_PHONE_WINDOW=600
# الجهاز: 5 طلبات خلال 10 دقائق
OTP_RATE_DEVICE_LIMIT=5
OTP_RATE_DEVICE_WINDOW=600
# IP: 10 طلبات خلال 10 دقائق
OTP_RATE_IP_LIMIT=10
OTP_RATE_IP_WINDOW=600

# طابعة لا SMS — التطوير لا يجب أن يرسل رسائل حقيقية
OTP_DELIVERY_BACKEND=console

# ------------------------ المطابقة ------------------------
MATCHING_NORMAL_DRIVER_LIMIT=10
MATCHING_MARKETPLACE_DRIVER_LIMIT=40
MATCHING_NORMAL_RADIUS_KM=5
MATCHING_MARKETPLACE_RADIUS_KM=10
RIDE_OFFER_TTL_SECONDS=30

# ----------------------- الإشعارات -----------------------
# الطابعة افتراضيًّا: الإشعارات تظهر في السجلّ ولا تصل هاتفًا.
# لتجربة FCM الحقيقيّ: ضع مفتاح الخادم في المجلّد FCM_SECRETS_DIR (خارج
# المستودع) وفعّل السطرين التاليين بدل الطابعة. لا ترفع المفتاح أبدًا.
NOTIFICATION_BACKEND=notifications.backends.console.ConsoleBackend
# NOTIFICATION_BACKEND=notifications.backends.fcm.FCMBackend
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase/<اسم-ملفّ-المفتاح>.json

# ------------------------- الخرائط -------------------------
# اجعلها False إن كنت تعمل بلا إنترنت، وإلا فشلت طلبات التسعير
# التي تحتاج مسافة طريق حقيقية.
MAPS_ROUTING_ENABLED=True
MAPS_ROUTING_REQUIRED=False
MAPS_ROUTING_BASE_URL=https://router.project-osrm.org

# ------------------------- المدفوعات -------------------------
PAYMENT_DEFAULT_GATEWAY=cash

# ------------------------- GeoDjango -------------------------
# فارغان عمدًا وليسا محذوفَين: ملفّ .env المحلّي يحوي مسارات ويندوز
# (C:\...\gdal313.dll) وsettings يقرأه أيضًا، فلو تركنا هذين المفتاحين
# غائبَين هنا لتسرّبت قيم ويندوز إلى الحاوية وانهار GeoDjango.
# القيمة الفارغة falsy، فيبحث GeoDjango عن المكتبات بنفسه ويجدها.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=


# ------------------- تجمّع اتصالات القاعدة -------------------
# الحدّ الأقصى لكلّ عملية. web + celery + beat = ثلاث عمليّات، فاضرب
# القيمة في ثلاثة وقارنها بـmax_connections في compose (200 هنا).
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_TIMEOUT=10
DB_POOL_MAX_IDLE=300

# عدد خيوط daphne لتنفيذ الـviews المتزامنة. تركه بلا حدّ يجعل عدد
# الاتصالات المطلوبة يتبع عدد الطلبات لا سعة القاعدة.
ASGI_THREADS=24
